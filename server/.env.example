# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/college_erp?schema=public"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
UPLOAD_MAX_SIZE_MB=5
